@startuml UseCaseDiagram

left to right direction
skinparam packageStyle rectangle

actor "Admin" as admin
actor "ICT Staff" as ict
actor "Branch Manager" as bm

rectangle "EUCL Inventory System" {

    ' ─── Department Management ────────────────────────
    package "Department Management" {
        usecase "Add Department" as UC24
        usecase "View Departments" as UC25
        usecase "Update Department" as UC26
        usecase "Delete Department" as UC27
    }

    ' ─── Branch Management ─────────────────────────
    package "Branch Management" {
        usecase "Add Branch" as UC1
        usecase "View Branches" as UC2
        usecase "Update Branch" as UC3
        usecase "Delete Branch" as UC4
    }

    ' ─── Employee Management ─────────────────────────
    package "Employee Management" {
        usecase "Add Employee" as UC5
        usecase "View Employees" as UC6
        usecase "Filter by Department" as UC7
        usecase "Filter by Branch" as UC8
        usecase "Update Employee" as UC9
        usecase "Delete Employee" as UC10
    }

    ' ─── Device Management ───────────────────────────
    package "Device Management" {
        usecase "Register Device" as UC11
        usecase "View Devices" as UC12
        usecase "Filter by Status" as UC13
        usecase "Filter by Branch" as UC14
        usecase "Update Device" as UC15
        usecase "Delete Device" as UC16
        usecase "Change Device Status" as UC28
        usecase "View Device Status History" as UC29
    }

    ' ─── Assignment & Tracking ───────────────────────
    package "Assignment & Tracking" {
        usecase "Assign Device to Employee" as UC17
        usecase "Unassign Device" as UC18
        usecase "View Device History" as UC20
        usecase "View Employee Active Devices" as UC21
    }

    ' ─── Repair Request Management ───────────────────
    package "Repair Request Management" {
        usecase "Submit Repair Request" as UC30
        usecase "View Own Branch Requests" as UC31
        usecase "View All Repair Requests" as UC32
        usecase "Set Request IN_PROGRESS" as UC33
        usecase "Set Request REPAIRED" as UC34
        usecase "Set Request UNREPAIRABLE" as UC35
        usecase "Filter Requests by Status" as UC36
    }

    ' ─── User Management ─────────────────────────────
    package "User Management" {
        usecase "Create User Account" as UC22
        usecase "View Users" as UC37
        usecase "Update User" as UC38
        usecase "Delete User" as UC39
    }

    ' ─── Permission Management ───────────────────────
    package "Permission Management" {
        usecase "View User Permissions" as UC40
        usecase "Set User Permissions" as UC41
        usecase "Grant Permissions" as UC42
        usecase "Revoke Permissions" as UC43
        usecase "Reset to Role Defaults" as UC44
    }
}

