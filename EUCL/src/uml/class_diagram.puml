@startuml ClassDiagram

skinparam classAttributeIconSize 0
skinparam linetype ortho

' ─── Enums ───────────────────────────────────────────
enum DeviceStatus {
    ACTIVE
    IN_REPAIR
    DECOMMISSIONED
    UNASSIGNED
}

enum UserRole {
    ADMIN
    ICT_STAFF
    BRANCH_MANAGER
}

enum RepairStatus {
    PENDING
    IN_PROGRESS
    REPAIRED
    UNREPAIRABLE
}

' ─── Abstract Base Class ─────────────────────────────
abstract class Auditable {
    # createdAt : LocalDateTime
    # createdBy : AppUser
    # updatedAt : LocalDateTime
    # updatedBy : AppUser
}

' ─── Entities ────────────────────────────────────────
class Branch {
    - id : Long
    - name : String
    - address : String
}

class Department {
    - id : Long
    - name : String
}

class Employee {
    - id : Long
    - employeeId : String
    - name : String
    - department : Department
    - branch : Branch
}

class Device {
    - id : Long
    - tagNumber : String
    - model : String
    - serialNumber : String
    - deviceType : String
    - status : DeviceStatus
    - branch : Branch
}

class DeviceStatusHistory {
    - id : Long
    - device : Device
    - changedBy : AppUser
    - oldStatus : DeviceStatus
    - newStatus : DeviceStatus
    - reason : String
    - changedAt : LocalDateTime
}

class DeviceAssignment {
    - id : Long
    - device : Device
    - employee : Employee
    - assignedBy : AppUser
    - branch : Branch
    - assignedAt : LocalDateTime
    - unassignedAt : LocalDateTime
    - note : String
    - isActive : Boolean
}

class AppUser {
    - id : Long
    - username : String
    - password : String
    - role : UserRole
    - employee : Employee
}

class RepairRequest {
    - id : Long
    - device : Device
    - requestedBy : AppUser
    - handledBy : AppUser
    - status : RepairStatus
    - issueDescription : String
    - resolutionNote : String
    - requestedAt : LocalDateTime
    - resolvedAt : LocalDateTime
}

' ─── Services ────────────────────────────────────────
class DepartmentService {
    + create(request) : Department
    + findAll() : List<Department>
    + findById(id) : Department
    + update(id, request) : Department
    + delete(id) : void
}

class BranchService {
    + create(request) : Branch
    + findAll() : List<Branch>
    + findById(id) : Branch
    + update(id, request) : Branch
    + delete(id) : void
}

class EmployeeService {
    + create(request) : Employee
    + findAll() : List<Employee>
    + findById(id) : Employee
    + findByDepartment(dept) : List<Employee>
    + findByBranch(branchId) : List<Employee>
    + update(id, request) : Employee
    + delete(id) : void
}

class DeviceService {
    + create(request) : Device
    + findAll() : List<Device>
    + findById(id) : Device
    + findByStatus(status) : List<Device>
    + findByBranch(branchId) : List<Device>
    + update(id, request) : Device
    + delete(id) : void
}

class DeviceAssignmentService {
    + assign(request) : DeviceAssignment
    + unassign(assignmentId, note) : DeviceAssignment
    + getHistory(deviceId) : List<DeviceAssignment>
    + getActiveByEmployee(employeeId) : List<DeviceAssignment>
}

class DeviceStatusHistoryService {
    + changeStatus(request) : DeviceStatusHistory
    + getHistory(deviceId) : List<DeviceStatusHistory>
}

class RepairRequestService {
    + submit(dto) : RepairRequest
    + updateStatus(id, dto) : RepairRequest
    + findAll() : List<RepairRequest>
    + findByBranch(userId) : List<RepairRequest>
    + findByStatus(status) : List<RepairRequest>
}

' ─── Controllers ─────────────────────────────────────
class DepartmentController {
    + POST /departments
    + GET /departments
    + GET /departments/{id}
    + PUT /departments/{id}
    + DELETE /departments/{id}
}

class BranchController {
    + POST /branches
    + GET /branches
    + GET /branches/{id}
    + PUT /branches/{id}
    + DELETE /branches/{id}
}

class EmployeeController {
    + POST /employees
    + GET /employees
    + GET /employees/{id}
    + GET /employees/department/{dept}
    + GET /employees/branch/{branchId}
    + PUT /employees/{id}
    + DELETE /employees/{id}
}

class DeviceController {
    + POST /devices
    + GET /devices
    + GET /devices/{id}
    + GET /devices/status/{status}
    + GET /devices/branch/{branchId}
    + PUT /devices/{id}
    + DELETE /devices/{id}
}

class DeviceAssignmentController {
    + POST /assignments/assign
    + PUT /assignments/{id}/unassign
    + GET /assignments/device/{deviceId}/history
    + GET /assignments/employee/{employeeId}/active
}

class DeviceStatusHistoryController {
    + PUT /devices/{id}/status
    + GET /devices/{id}/status-history
}

class RepairRequestController {
    + POST /repair-requests
    + PUT /repair-requests/{id}/status
    + GET /repair-requests
    + GET /repair-requests/branch?userId={id}
    + GET /repair-requests/status/{status}
}

' ─── Repositories ────────────────────────────────────
interface DepartmentRepository
interface BranchRepository
interface EmployeeRepository
interface DeviceRepository
interface DeviceAssignmentRepository
interface DeviceStatusHistoryRepository
interface RepairRequestRepository
interface AppUserRepository

' ─── Inheritance ─────────────────────────────────────
Auditable <|-- Branch
Auditable <|-- Department
Auditable <|-- Employee
Auditable <|-- Device

' ─── Entity Relationships ────────────────────────────
Employee --> Department
Employee --> Branch
Device --> DeviceStatus
Device --> Branch
DeviceAssignment --> Device
DeviceAssignment --> Employee
DeviceAssignment --> AppUser
DeviceAssignment --> Branch
DeviceStatusHistory --> Device
DeviceStatusHistory --> DeviceStatus
DeviceStatusHistory --> AppUser
RepairRequest --> Device
RepairRequest --> RepairStatus
RepairRequest --> AppUser
AppUser --> UserRole
AppUser --> Employee

' ─── Service → Repository ────────────────────────────
DepartmentService --> DepartmentRepository
BranchService --> BranchRepository
EmployeeService --> EmployeeRepository
EmployeeService --> DepartmentRepository
DeviceService --> DeviceRepository
DeviceAssignmentService --> DeviceAssignmentRepository
DeviceAssignmentService --> DeviceRepository
DeviceAssignmentService --> EmployeeRepository
DeviceStatusHistoryService --> DeviceStatusHistoryRepository
DeviceStatusHistoryService --> DeviceRepository
RepairRequestService --> RepairRequestRepository
RepairRequestService --> DeviceRepository
RepairRequestService --> AppUserRepository
RepairRequestService --> DeviceAssignmentRepository
RepairRequestService --> DeviceStatusHistoryRepository

' ─── Controller → Service ────────────────────────────
DepartmentController --> DepartmentService
BranchController --> BranchService
EmployeeController --> EmployeeService
DeviceController --> DeviceService
DeviceAssignmentController --> DeviceAssignmentService
DeviceStatusHistoryController --> DeviceStatusHistoryService
RepairRequestController --> RepairRequestService

@enduml
