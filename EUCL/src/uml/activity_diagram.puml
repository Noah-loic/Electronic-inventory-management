@startuml ActivityDiagram

skinparam activityBackgroundColor #f0f8ff
skinparam activityBorderColor #336699
skinparam arrowColor #336699

title EUCL Inventory - Core Activity Flows

' ══════════════════════════════════════════
' FLOW 1: Register a Device
' ══════════════════════════════════════════
|ICT Staff / Admin|
start
:Provide device details\n(tag number, model, serial number,\ndevice type, branch);

|System|
if (Tag number or serial number already exists?) then (yes)
    :Return error: Duplicate device;
    stop
else (no)
    :Save device with status = UNASSIGNED;
    :Return created device;
endif

' ══════════════════════════════════════════
' FLOW 2: Assign Device to Employee
' ══════════════════════════════════════════
|ICT Staff / Admin|
:Select device and employee\nto assign;

|System|
if (Device status is ACTIVE or UNASSIGNED?) then (no)
    :Return error: Device not available\n(In Repair or Decommissioned);
    stop
else (yes)
    if (Device already has an active assignment?) then (yes)
        :Return error: Device already assigned;
        stop
    else (no)
        :Create DeviceAssignment record\n(isActive = true, assignedAt = now);
        :Update device status to ACTIVE;
        :Return assignment details;
    endif
endif

' ══════════════════════════════════════════
' FLOW 3: Unassign Device
' ══════════════════════════════════════════
|ICT Staff / Admin|
:Select active assignment to unassign\n(optional: add note);

|System|
if (Assignment exists and is active?) then (no)
    :Return error: No active assignment found;
    stop
else (yes)
    :Set unassignedAt = now, isActive = false;
    :Update device status to UNASSIGNED;
    :Return updated assignment;
endif

' ══════════════════════════════════════════
' FLOW 4: Change Device Status
' ══════════════════════════════════════════
|ICT Staff / Admin|
:Select device and provide\nnew status and reason;

|System|
if (New status same as current status?) then (yes)
    :Return error: Status unchanged;
    stop
else (no)
    if (New status is IN_REPAIR or DECOMMISSIONED\nand device has active assignment?) then (yes)
        :Unassign device\n(close active assignment);
    else (no)
    endif
    :Record old and new status\nin device_status_history;
    :Update device status;
    :Return updated device;
endif

' ══════════════════════════════════════════
' FLOW 5: Submit Repair Request
' ══════════════════════════════════════════
|Branch Manager / Admin|
:Select device and provide\nissue description;

|System|
if (User is BRANCH_MANAGER or ADMIN?) then (no)
    :Return error: Unauthorized;
    stop
else (yes)
    :Create RepairRequest\n(status = PENDING);
    :Return repair request;
endif

' ══════════════════════════════════════════
' FLOW 6: Handle Repair Request (ICT Staff)
' ══════════════════════════════════════════
|ICT Staff / Admin|
:Select repair request\nand provide new status + resolution note;

|System|
if (User is ICT_STAFF or ADMIN?) then (no)
    :Return error: Unauthorized;
    stop
else (yes)
    if (New status = IN_PROGRESS?) then (yes)
        :Update device status to IN_REPAIR;
        if (Device has active assignment?) then (yes)
            :Close active assignment\n(unassignedAt = now, isActive = false);
        else (no)
        endif
    else if (New status = REPAIRED?) then (yes)
        :Update device status to UNASSIGNED;
        :Set resolvedAt = now;
    else (UNREPAIRABLE)
        :Update device status to DECOMMISSIONED;
        :Set resolvedAt = now;
    endif
    :Record status change in device_status_history;
    :Update repair request\n(status, handledBy, resolutionNote);
    :Return updated repair request;
endif

' ══════════════════════════════════════════
' FLOW 7: Transfer Device
' ══════════════════════════════════════════
|ICT Staff / Admin|
:To reassign a device, first unassign it\nthen assign it to the new employee;

stop

' ══════════════════════════════════════════
' FLOW 8: View Device History
' ══════════════════════════════════════════
|ICT Staff / Admin|
:Request history for a device;

|System|
:Fetch all DeviceAssignment records\nfor the device ordered by assignedAt DESC;
:Return full assignment history\n(employee, dates, assigned by, notes);

stop

' ══════════════════════════════════════════
' FLOW 9: Create User
' ══════════════════════════════════════════
|Admin|
:Provide user details\n(username, password, role, employeeId);

|System|
if (Username already exists?) then (yes)
    :Return error: Duplicate username;
    stop
else (no)
    :Create user account;
    :Assign default permissions\nbased on role;
    :Return created user with permissions;
endif

' ══════════════════════════════════════════
' FLOW 10: Manage User Permissions
' ══════════════════════════════════════════
|Admin|
:Select user and choose permission action\n(set / grant / revoke / reset);

|System|
if (Action = SET?) then (yes)
    :Replace all permissions\nwith provided set;
else if (Action = GRANT?) then (yes)
    :Add provided permissions\nto existing ones;
else if (Action = REVOKE?) then (yes)
    :Remove provided permissions\nfrom existing ones;
else (RESET)
    :Restore default permissions\nbased on user role;
endif
:Return updated user with new permissions;

stop

@enduml
